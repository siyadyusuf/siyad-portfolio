# true (default for `npm run dev`): in-browser mock API with SAMPLE data.
# false: call the real backend at /api. Production builds set this in .env.production.
VITE_USE_MOCKS=true
# Where Vite proxies /api when VITE_USE_MOCKS=false (backend default port is 3001).
API_PROXY_TARGET=http://localhost:3001
# Leave VITE_API_BASE unset. Dev uses the proxy above; production uses same-origin /api
# (frontend/vercel.json forwards it to the API host).
